{
    "name": "ismailnakkar/laravel-mail-frame",
    "description": "One hand-tuned HTML frame for Laravel notification mail, with an ordered block builder, right-to-left support and a plain-text part.",
    "keywords": [
        "laravel",
        "mail",
        "notifications",
        "email-template",
        "rtl"
    ],
    "homepage": "https://github.com/ismailnakkar/laravel-mail-frame",
    "license": "MIT",
    "authors": [
        {
            "name": "Ismail Nakkar",
            "email": "juge.steam@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ismailnakkar/laravel-mail-frame/issues"
    },
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "laravel/framework": "^13.0",
        "symfony/polyfill-php85": "^1.43"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5.8 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "MailFrame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailFrame\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MailFrame\\MailFrameServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@lint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
